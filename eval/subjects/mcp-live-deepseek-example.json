{
  "formatVersion": 1,
  "schema": "och.eval.subject",
  "id": "mcp-live-deepseek-example",
  "repositoryRevision": "dev",
  "repositoryDirty": false,
  "provider": {
    "adapterKind": "openaicompat",
    "normalizedEndpoint": "https://api.deepseek.com",
    "modelId": "deepseek-v4-pro",
    "contextWindow": 1000000,
    "maxOutput": 4096,
    "credentialEnvVar": "OCH_EVAL_LIVE_PROVIDER_API_KEY",
    "includeUsage": true,
    "maxTokensField": "max_tokens",
    "reasoningEffort": "high",
    "lane": "live"
  },
  "context": {
    "summaryReasoningEffort": "none",
    "triggerPercent": 90,
    "targetPercent": 50,
    "tailPercent": 10,
    "maxSummaryChunks": 8,
    "maxOverflowCompactionsPerTurn": 2,
    "maxPrunedToolResultsPerRequest": 64,
    "compactionTimeout": 120000000000
  },
  "policy": {
    "mode": "default",
    "toolCatalogIdentity": "catalog-v1+mcp-fixture-v1",
    "limits": {},
    "sandboxPolicy": "unsandboxed_allowed"
  },
  "mcpServers": [
    {"name": "fixture", "command": "sh", "args": ["mcp-fixture.sh"]}
  ]
}
