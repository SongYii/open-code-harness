{
  "formatVersion": 1,
  "schema": "och.eval.subject",
  "id": "subagent-subject",
  "repositoryRevision": "dev",
  "repositoryDirty": false,
  "provider": {
    "adapterKind": "openaicompat",
    "normalizedEndpoint": "fixture://smart",
    "modelId": "subagent-fixture-model",
    "contextWindow": 4096,
    "maxOutput": 512,
    "credentialEnvVar": "OCH_EVAL_SUBAGENT_API_KEY",
    "lane": "fixture"
  },
  "context": {
    "triggerPercent": 95,
    "targetPercent": 50,
    "tailPercent": 10,
    "maxSummaryChunks": 8,
    "maxOverflowCompactionsPerTurn": 2,
    "maxPrunedToolResultsPerRequest": 64,
    "compactionTimeout": 120000000000
  },
  "policy": {
    "mode": "default",
    "toolCatalogIdentity": "catalog-v1+delegate-task-v1",
    "limits": {},
    "sandboxPolicy": "unsandboxed_allowed"
  },
  "subagents": {
    "enabled": true,
    "timeout": 45000000000
  }
}
